DATA_DIR=data/owasp
DOWNLOAD_TIMEOUT_SECONDS=30
# Retries after the initial attempt (0-5).
DOWNLOAD_RETRIES=2
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=owasp_security_2026
# Set a local password and use its URL-encoded value in DATABASE_URL.
POSTGRES_DB=security_rag
POSTGRES_USER=security_rag
POSTGRES_PASSWORD=
DATABASE_URL=
# Example: postgresql://security_rag:<password>@localhost:5432/security_rag
DATABASE_POOL_SIZE=4
DATABASE_TIMEOUT_SECONDS=10
INGESTION_BATCH_SIZE=32
EMBEDDING_CACHE_DIR=data/models
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHILD_MAX_TOKENS=450
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
BM25_K=1.2
BM25_B=0.75
BM25_TOKEN_MAX_LENGTH=512
# Average lexical length is measured once and persisted in PostgreSQL.
# Changing the frozen configuration is deferred to the document-update phase.
TOKENIZER_REVISION=main
# Optional path to the matching tokenizer.json for offline chunking.
# TOKENIZER_PATH=/path/to/tokenizer.json
# Local Ollama in Docker; no API key is required.
LLM_BASE_URL=http://localhost:11434
# Set the exact installed Qwen tag shown by `docker compose exec ollama ollama list`.
LLM_MODEL=
# Passed to Ollama as num_ctx; budgeting uses a conservative local estimate.
LLM_CONTEXT_WINDOW=4096
LLM_MAX_OUTPUT_TOKENS=512
LLM_TIMEOUT_SECONDS=120
