DATA_DIR=data/owasp
DOWNLOAD_TIMEOUT_SECONDS=30
# Retries after the initial attempt (0-5).
DOWNLOAD_RETRIES=2
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=owasp_security_2026
# Set a local password and use its URL-encoded value in DATABASE_URL.
POSTGRES_DB=security_rag
POSTGRES_USER=security_rag
POSTGRES_PASSWORD=
DATABASE_URL=
# Example: postgresql://security_rag:<password>@localhost:5432/security_rag
DATABASE_POOL_SIZE=4
DATABASE_TIMEOUT_SECONDS=10
INGESTION_BATCH_SIZE=32
EMBEDDING_CACHE_DIR=data/models
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TOKENIZER_REVISION=main
# Optional path to the matching tokenizer.json for offline chunking.
# TOKENIZER_PATH=/path/to/tokenizer.json
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
